pipeline {
    agent any

    stages {
        stage('Hello') {
            steps {
                echo 'Hello jenkins'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('App_practical/4_Calculator/4_Calculator') {
                    sh 'ls -l'
                    sh 'docker compose build'
                }
            }
        }

        stage('Start Docker Container') {
            steps {
                dir('App_practical/4_Calculator/4_Calculator') {
                    sh 'docker compose up -d'
                }
            }
        }
    }
}
